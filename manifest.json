{
  "manifest_version": 3,
  "name": "YouTube Nano Chapters",
  "version": "1.0.0",
  "minimum_chrome_version": "138",
  "description": "Create YouTube chapters on your device, with Gemini Nano titles.",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Generate YouTube chapters",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
